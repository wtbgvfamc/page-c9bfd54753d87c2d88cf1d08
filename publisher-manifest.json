kground:var(--violet-wash);border:2px solid var(--violet);border-radius:50%}\n  .plan-note{margin-top:26px;font-size:.9rem;color:var(--ink-soft);max-width:62ch}\n\n  /* 对比条 */\n  .ledger{margin-top:36px;border:1px solid var(--line);background:#fff}\n  .ledger-row{display:grid;grid-template-columns:1.2fr 1fr 1fr 1fr;font-size:.92rem}\n  .ledger-row > div{padding:14px 16px;border-bottom:1px solid var(--line)}\n  .ledger-row:last-child > div{border-bottom:0}\n  .ledger-row.head > div{background:var(--violet-wash);font-weight:700;font-size:.84rem;letter-spacing:.06em}\n  .ledger-row > div + div{border-left:1px solid var(--line)}\n  .ledger-row.head > div + div{border-left:1px solid #d9ceff}\n\n  /* 客户端区块 */\n  .clients{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:36px}\n  .client{background:#fff;border-left:5px solid var(--violet-soft);padding:24px 24px 20px;border-top:1px solid var(--line);border-right:1px solid var(--line);border-bottom:1px solid var(--line)}\n  .client h3{font-size:1.05rem;margin-bottom:8px}\n  .client p{font-size:.92rem;color:var(--ink-soft);margin:0}\n  .client .os{display:block;font-size:.74rem;letter-spacing:.22em;color:var(--violet);font-weight:700;margin-bottom:10px}\n\n  /* FAQ：details 折叠 */\n  .faq{margin-top:34px;border-top:1px solid var(--line)}\n  details{border-bottom:1px solid var(--line)}\n  summary{cursor:pointer;padding:20px 44px 20px 0;font-weight:700;font-size:1.02rem;position:relative;list-style:none}\n  summary::-webkit-details-marker{display:none}\n  summary::after{content:\"＋\";position:absolute;right:6px;top:18px;color:var(--violet);font-weight:700;font-size:1.15rem}\n  details[open] summary::after{content:\"－\"}\n  details .answer{padding:0 0 22px;max-width:64ch;color:var(--ink-soft);font-size:.96rem}\n  details .answer p:last-child{margin-bottom:0}\n\n  /* 底部固定文字导航 */\n  .dock{position:fixed;left:0;right:0;bottom:0;background:var(--ink);color:#efeef4;z-index:20;border-top:1px solid #2c2a34}\n  .dock .wrap{display:flex;flex-wrap:wrap;gap:6px 22px;align-items:center;padding:11px 0;font-size:.85rem}\n  .dock a{text-decoration:none;color:#efeef4;letter-spacing:.04em;border-bottom:1px solid transparent;padding-bottom:1px}\n  .dock a:hover,.dock a:focus{color:#c6aaff;border-bottom-color:#c6aaff}\n  .dock .dock-mark{margin-left:auto;color:#8f8ca0;letter-spacing:.22em;font-size:.72rem}\n\n  footer{padding:52px 0 24px;font-size:.88rem;color:var(--ink-soft)}\n  footer .brandname{font-weight:800;color:var(--ink);letter-spacing:.06em}\n\n  @media (max-width:820px){\n    .band-d .threecol{grid-template-columns:1fr}\n    .band-d .threecol div{border-right:0;border-bottom:1px solid var(--line);padding:18px 0}\n    .band-d .threecol div:last-child{border-bottom:0}\n    .howto{grid-template-columns:1fr}\n    .plan{grid-template-columns:1fr;padding:26px 22px}\n    .clients{grid-template-columns:1fr}\n    .ledger-row{grid-template-columns:1fr;font-size:.9rem}\n    .ledger-row > div + div{border-left:0}\n    .ledger-row.head{display:none}\n    .ledger-row > div:first-child{background:var(--violet-wash);font-weight:700}\n    .dock .dock-mark{display:none}\n  }\n</style><main>\n\n  <div class=\"band band-a\">\n    <div class=\"wrap masthead\">\n      <div class=\"brandline\">光速云 · 月度方案页面</div>\n      <div class=\"issue\">阅读约 6 分钟 ／ 含套餐与说明</div>\n    </div>\n  </div>\n\n  <div class=\"band band-b\">\n    <div class=\"wrap\">\n      <h1>光速云：把<em>网络入口</em>按月租，把选择权交回手里</h1>\n      <p class=\"lede\">我们习惯把订阅当成一次长期承诺，但多数人真正需要的是<strong>一段可以用得明白、随时可以重新决定的时间</strong>。这份页面不推销速度，只把档位、边界与操作方式摊开写清楚。</p>\n    </div>\n  </div>\n\n  <div class=\"band band-c\">\n    <div class=\"wrap\">\n      <div class=\"strip\">\n        <span>三档流量</span>\n        <span>设备数可核</span>\n        <span>年付折算</span>\n        <span>多端说明</span>\n        <span>问答式 FAQ</span>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"band band-d\">\n    <div class=\"wrap threecol\">\n      <div>\n        <h3>先看档位</h3>\n        <p>基础、旗舰、团队三档，差别集中在每月流量、同时在线设备数与节点池范围，其余条款一致。</p>\n      </div>\n      <div>\n        <h3>再看时间</h3>\n        <p>月付即可起步；若愿意一次付满一年，年付价格在套餐卡中逐档写明，按折算更省。</p>\n      </div>\n      <div>\n        <h3>最后看操作</h3>\n        <p>下单、配置、多端登录、更换设备，四个动作构成完整使用流程，页面下方逐步说明。</p>\n      </div>\n    </div>\n  </div>\n\n  <section id=\"howto\">\n    <div class=\"wrap\">\n      <div class=\"kicker\">使用说明</div>\n      <h2>从挑选到日常使用，一共四步</h2>\n      <p class=\"section-intro\">这四步的顺序不宜颠倒：先想清楚用量，再决定档位，然后才谈配置。跳过前两步，通常会在第一个月就换档。</p>\n\n      <div class=\"howto\">\n        <article class=\"step\">\n          <div class=\"num\">步骤 01</div>\n          <h3>估一个月的真实用量</h3>\n          <p>翻一下最近三十天的使用记录：主要是网页与文档，还是视频与下载。两者对流量档位的要求差别很大，先分清类型再谈容量。</p>\n        </article>\n        <article class=\"step\">\n          <div class=\"num\">步骤 02</div>\n          <h3>按设备数选档位</h3>\n          <p>把手机、平板、电脑与家用设备加起来，算一个同时在线的高峰数量。档位里写明的设备数与这个数字对齐，才算选对。</p>\n        </article>\n        <article class=\"step\">\n          <div class=\"num\">步骤 03</div>\n          <h3>完成订阅并进入客户端</h3>\n          <p>订阅开通后，按所用系统进入对应客户端完成连接配置。不同系统的界面不同，但需要填写的信息类别是一致的。</p>\n        </article>\n        <article class=\"step\">\n          <div class=\"num\">步骤 04</div>\n          <h3>按周期复核用量</h3>\n          <p>每月末回看一次流量与设备使用情况。长期用不满可以降档，长期提前耗尽则值得考虑升档，这是比一次性选对更可靠的做法。</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"plans\">\n    <div class=\"wrap\">\n      <div class=\"kicker\">套餐</div>\n      <h2>三档方案，逐张摊开写</h2>\n      <p class=\"section-intro\">价格与权益如下所列。年付一栏为按年一次性支付的价格，是否划算取决于你打算用多久，而不是取决于折扣幅度看起来有多大。</p>\n\n      <div class=\"plans\">\n\n        <article class=\"plan\">\n          <div>\n            <div class=\"plan-head\">\n              <h3>基础版</h3>\n            </div>\n            <div class=\"price\">¥15<small>／月</small></div>\n            <div class=\"annual\">按年付 ¥150／年</div>\n          </div>\n          <ul>\n            <li>每月 100GB 流量额度</li>\n            <li>支持 3 台设备同时在线</li>\n            <li>基础流媒体解锁</li>\n            <li>标准线路节点池</li>\n          </ul>\n        </article>\n\n        <article class=\"plan is-featured\">\n          <div>\n            <div class=\"plan-head\">\n              <h3>旗舰版</h3>\n              <span class=\"tag\">多数人的选择</span>\n            </div>\n            <div class=\"price\">¥35<small>／月</small></div>\n            <div class=\"annual\">按年付 ¥350／年</div>\n          </div>\n          <ul>\n            <li>每月 300GB 流量额度</li>\n            <li>支持 5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线游戏加速优化</li>\n            <li>7×24 优先工单支持</li>\n          </ul>\n        </article>\n\n        <article class=\"plan\">\n          <div>\n            <div class=\"plan-head\">\n              <h3>团队版</h3>\n            </div>\n            <div class=\"price\">¥85<small>／月</small></div>\n            <div class=\"annual\">按年付 ¥850／年</div>\n          </div>\n          <ul>\n            <li>每月 1000GB 流量额度</li>\n            <li>支持 20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理服务</li>\n          </ul>\n        </article>\n\n      </div>\n\n      <div class=\"ledger\" role=\"table\" aria-label=\"三档方案对照\">\n        <div class=\"ledger-row head\" role=\"row\">\n          <div role=\"columnheader\">对照项</div>\n          <div role=\"columnheader\">基础版</div>\n          <div role=\"columnheader\">旗舰版</div>\n          <div role=\"columnheader\">团队版</div>\n        </div>\n        <div class=\"ledger-row\" role=\"row\">\n          <div role=\"rowheader\">月付价格</div>\n          <div>¥15／月</div>\n          <div>¥35／月</div>\n          <div>¥85／月</div>\n        </div>\n        <div class=\"ledger-row\" role=\"row\">\n          <div role=\"rowheader\">年付价格</div>\n          <div>¥150／年</div>\n          <div>¥350／年</div>\n          <div>¥850／年</div>\n        </div>\n        <div class=\"ledger-row\" role=\"row\">\n          <div role=\"rowheader\">每月流量</div>\n          <div>100GB</div>\n          <div>300GB</div>\n          <div>1000GB</div>\n        </div>\n        <div class=\"ledger-row\" role=\"row\">\n          <div role=\"rowheader\">同时在线设备</div>\n          <div>3 台</div>\n          <div>5 台</div>\n          <div>20 台</div>\n        </div>\n        <div class=\"ledger-row\" role=\"row\">\n          <div role=\"rowheader\">节点池</div>\n          <div>标准线路</div>\n          <div>全节点</div>\n          <div>VIP 专属高带宽</div>\n        </div>\n      </div>\n\n      <p class=\"plan-note\">说明：以上价格与权益为当前页面列出的方案内容，未在本页列出的附加条件不作默认承诺。若你打算先试用再决定，建议从月付起步，而不是直接按年支付。</p>\n    </div>\n  </section>\n\n  <section id=\"clients\">\n    <div class=\"wrap\">\n      <div class=\"kicker\">客户端</div>\n      <h2>按系统进入，填写的信息类别一致</h2>\n      <p class=\"section-intro\">不同系统的客户端界面各有差异，但需要准备的东西基本相同：订阅信息与连接配置。以下按平台说明入口位置与常见操作路径，具体下载地址请以你获取订阅时的官方说明为准。</p>\n\n      <div class=\"clients\">\n        <article class=\"client\">\n          <span class=\"os\">Windows</span>\n          <h3>桌面端配置</h3>\n          <p>安装后在配置入口导入订阅信息，确认节点列表刷新成功，再选择一条线路连接。切换线路后建议重新确认一次连接状态。</p>\n        </article>\n        <article class=\"client\">\n          <span class=\"os\">macOS</span>\n          <h3>桌面端配置</h3>\n          <p>操作路径与 Windows 接近，配置完成后在系统网络设置中确认权限已允许。若提示权限问题，按系统引导逐步放行。</p>\n        </article>\n        <article class=\"client\">\n          <span class=\"os\">Android</span>\n          <h3>移动端配置</h3>\n          <p>导入订阅后先授予连接所需权限，再启动连接。移动网络与 Wi-Fi 之间切换时，可能需要重新选择线路。</p>\n        </article>\n        <article class=\"client\">\n          <span class=\"os\">iOS</span>\n          <h3>移动端配置</h3>\n          <p>通过订阅链接添加配置，首次连接会请求系统级权限，允许后才能正常使用。多设备共享时注意档位写明的设备上限。</p>\n        </article>\n        <article class=\"client\">\n          <span class=\"os\">Linux</span>\n          <h3>命令行配置</h3>\n          <p>以配置文件方式导入，适合熟悉终端操作的用户。配置文件本身包含订阅信息，注意保存位置与访问权限。</p>\n        </article>\n        <article class=\"client\">\n          <span class=\"os\">路由器</span>\n          <h3>家庭网络配置</h3>\n          <p>在路由器端完成配置后，家中设备可共用一条出口。此类用法对设备数消耗较大，选档时请把这部分计入。</p>\n        </article>\n      </div>\n\n      <p class=\"plan-note\">本页不提供下载链接：可靠地址以订阅开通后的说明为准，避免从非来源渠道获取安装包。</p>\n    </div>\n  </section>\n\n  <section id=\"faq\">\n    <div class=\"wrap\">\n      <div class=\"kicker\">常见问题</div>\n      <h2>十条问题，按你可能会问的顺序排列</h2>\n      <p class=\"section-intro\">点击问题可展开答案。若下面没有覆盖你的情况，优先查看订阅开通时给出的说明，那里通常写得更具体。</p>\n\n      <div class=\"faq\">\n\n        <details>\n          <summary>三档套餐最本质的差别是什么？</summary>\n          <div class=\"answer\">\n            <p>差别集中在三处：每月流量额度、允许同时在线的设备数、以及可用节点池的范围。价格随这三项递增，其余条款在三档之间保持一致，因此选择时不需要逐条比对服务内容，只需要判断自己对这三项的需求量。</p>\n          </div>\n        </details>\n\n        <details>\n          <summary>年付一定比月付划算吗？</summary>\n          <div class=\"answer\">\n            <p>只在一种情况下划算：你确实会用满一年。三档的年付价格分别是 ¥150、¥350、¥850，折算后低于十二个月的月付总额。但如果用量需求还在摸索阶段，月付虽然单价更高，换来的调整余地更实际。</p>\n          </div>\n        </details>\n\n        <details>\n          <summary>流量按什么周期重置？用不完会累积吗？</summary>\n          <div class=\"answer\">\n            <p>套餐按“每月”标注流量额度，指的是每个计费周期内可用的量，不是长期累计的余额。每个周期开始时重新计算，上一周期未用完的部分不作结转。页面不对具体重置时点作额外承诺，请以你订阅时说明的计费周期为准。</p>\n          </div>\n        </details>\n\n        <details>\n          <summary>设备数怎么计算？换设备算新增吗？</summary>\n          <div class=\"answer\">\n            <p>限制的是同时在线设备数，而不是历史登录过的设备总数。退出某台设备的连接后，该名额可以被其他设备使用。因此在手机、平板、电脑之间轮流切换使用的场景中，实际压力通常小于设备总数。</p>\n          </div>\n        </details>\n\n        <details>\n          <summary>在路由器上配置会占用几个设备名额？</summary>\n          <div class=\"answer\">\n            <p>路由器端配置通常会让出口以一台设备的身份计入，家中通过它上网的终端则共用这一个名额。这正是路由器方案受欢迎的原因，但如果你同时还在手机上单独连接，两者分别计数。</p>\n          </div>\n        </details>\n\n        <details>\n          <summary>提交工单后多久会有回应？</summary>\n          <div class=\"answer\">\n            <p>旗舰版包含优先工单支持。页面对响应速度不作具体分钟数承诺，建议在工单中一次写清系统类型、客户端名称、出现问题的操作步骤与报错内容，这些信息会直接影响处理效率。</p>\n          </div>\n        </details>\n\n        <details>\n          <summary>团队版和企业定制路由适合哪些情况？</summary>\n          <div class=\"answer\">\n            <p>适合需要在同一方案下覆盖较多设备、并且希望按内部网络结构安排出口的团队。如果只是两三个人各自使用，旗舰版的设备上限往往已经够用，无须为定制能力付费。</p>\n          </div>\n        </details>\n\n        <details>\n          <summary>换系统后原来的配置还能用吗？</summary>\n          <div class=\"answer\">\n            <p>订阅信息本身是跨系统的，但配置文件通常无法直接在另一个系统上使用。较稳妥的做法是在新系统上重新导入订阅信息并生成配置，确认连接正常后，再停止旧设备上的连接，以免占用同时在线的名额。</p>\n          </div>\n        </details>\n\n        <details>\n          <summary>页面为什么不提供客户端下载地址？</summary>\n          <div class=\"answer\">\n            <p>因为可靠的下载来源应当与你的订阅绑定。从第三方渠道获取安装包存在被替换的风险，而本页无法核实那些地址的真实性，所以选择留空，只说明操作路径。请以订阅开通后提供的说明为准。</p>\n          </div>\n        </details>\n\n        <details>\n          <summary>用了一个月发现档位不合适，怎么办？</summary>\n          <div class=\"answer\">\n            <p>先把用量数据看一下：是流量提前耗尽，还是同时在线的设备超限，两者对应的调整方向不同。前者考虑升档，后者也可能只是使用习惯问题。本页不承诺具体的变更与退款规则，实际操作请参照订阅时说明的条款。</p>\n          </div>\n        </details>\n\n      </div>\n    </div>\n  </section>\n\n  <footer>\n    <div class=\"wrap\">\n      <p><span class=\"brandname\">光速云</span>　月度方案页面。本页内容用于说明档位、使用方式与常见问题，价格与权益以页面正文所列内容为准；未列出的条件不作为默认承诺。</p>\n    </div>\n  </footer>\n\n</main>\n\n<nav class=\"dock\" aria-label=\"页面导航\">\n  <div class=\"wrap\">\n    <a href=\"#howto\">使用说明</a>\n    <a href=\"#plans\">套餐与对照</a>\n    <a href=\"#clients\">客户端</a>\n    <a href=\"#faq\">常见问题</a>\n    <span class=\"dock-mark\">光速云</span>\n  </div>\n</nav>",
